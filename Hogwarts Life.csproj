<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>HarryPotter</RootNamespace>
  </PropertyGroup>

  <!-- GodotInk: 自动下载 inklecate + 引用 ink runtime -->
  <Import Project="addons\GodotInk\GodotInk.props" />

  <!-- 排除 GodotMCP-master/ 目录（独立项目，不属于主项目）-->
  <ItemGroup>
    <Compile Remove="GodotMCP-master/**/*.cs" />
    <None Remove="GodotMCP-master/**" />
    <EmbeddedResource Remove="GodotMCP-master/**" />
  </ItemGroup>
</Project>
